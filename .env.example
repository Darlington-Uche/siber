# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Any Solana RPC endpoint. The public one works but rate-limits fast —
# a paid RPC (Helius, QuickNode, Triton, etc.) is strongly recommended
# for real trading.
RPC_URL=https://api.mainnet-beta.solana.com

# Optional: pin a specific master key for wallet encryption (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank, one is auto-generated into data/.masterkey on first run.
WALLET_MASTER_KEY=
